# Copy to .env for local use. On Render, set these in the dashboard instead.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///fullclear.db
APP_BASE_URL=http://localhost:5000

# Dodo Payments
DODO_ENV=test
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=whsec_...
DODO_PRODUCT_PRO=pdt_...
DODO_PRODUCT_TOOLKIT=pdt_...

# Optional: text shown on the store (the real price is set in Dodo)
PRICE_PRO=$4.99
PRICE_TOOLKIT=$9.99
